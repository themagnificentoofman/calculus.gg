    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "katex": "^0.16.38",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-katex": "^3.1.0",
    "tailwind-merge": "^3.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.0"
