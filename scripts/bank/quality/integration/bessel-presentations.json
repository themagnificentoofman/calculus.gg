    "sourceContentHash": "84da11811cc67ca4e4c10f1c3124bd6af7f15705a20c8551bd723aedac0ba7ec",
    "steps": [
      "\\text{Let }I\\text{ denote the requested integral.}",
      "a=2,\\ b=1,\\quad J_0(y)=\\frac1\\pi\\int_0^\\pi\\cos(y\\sin\\theta)\\,d\\theta",
      "\\frac1\\pi\\int_0^\\pi\\sin^{2j}\\theta\\,d\\theta=\\frac{(2j)!}{4^j(j!)^2}\\quad(j=0,1,2,\\ldots)",
      "\\text{Integrating the cosine series with these moments proves the angular identity.}",
      "\\text{The exponential majorant justifies absolute Fubini.}",
      "I=\\frac1\\pi\\int_0^\\pi\\frac{a\\,d\\theta}{a^2+b^2\\sin^2\\theta}",
      "u=\\tan\\theta\\quad(0<\\theta<\\pi/2),\\quad I=\\frac{2a}\\pi\\int_0^\\infty\\frac{du}{a^2+(a^2+b^2)u^2}=\\frac1{\\sqrt{a^2+b^2}}",
      "I=\\frac{\\sqrt{5}}{5}",
      "\\frac{\\sqrt{5}}{5}"
    ]
  },
