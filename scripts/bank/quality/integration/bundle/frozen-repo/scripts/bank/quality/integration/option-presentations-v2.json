  "cn_62ed8039c5ca14e69cb9": {
    "auditId": "io3-v1",
    "familyId": "io3-gamma-unit-average",
    "revision": 1,
    "sourceContentHash": "5c59b5bddaa55dd1122b042310df93a71d2836078f3dd1c8a5812999b3b9e3ef",
    "steps": [
      "\\text{Let }I\\text{ denote the requested integral.}",
      "F(t)=\\int_t^{t+1}\\ln\\Gamma(x)\\,dx\\quad(t>0),\\qquad I=F(3)",
      "F^{\\prime}(t)=\\ln\\Gamma(t+1)-\\ln\\Gamma(t)=\\ln t",
      "F(t)=t\\ln t-t+C,\\quad C\\in\\mathbb R",
      "F(0):=\\int_0^1\\ln\\Gamma(x)\\,dx=\\lim_{t\\downarrow0}F(t)",
      "\\Gamma(x)\\Gamma(1-x)=\\frac\\pi{\\sin\\pi x}\\quad(0<x<1)",
      "2F(0)=\\ln\\pi-\\int_0^1\\ln\\sin(\\pi x)\\,dx=\\ln(2\\pi)",
      "\\text{Here the endpoint integral is improper and converges.}",
      "S:=\\int_0^{\\pi/2}\\ln(\\sin t)dt=\\int_0^{\\pi/2}\\ln(\\cos t)dt",
      "2S=\\frac12\\int_0^\\pi\\ln(\\sin u)du-\\frac\\pi2\\ln2=S-\\frac\\pi2\\ln2",
      "\\int_0^1\\ln\\sin(\\pi x)dx=\\frac{2S}\\pi=-\\ln2",
      "F(t)=t\\ln t-t+\\tfrac12\\ln(2\\pi)",
      "I=-3 + \\frac{\\ln{\\left(2 \\pi \\right)}}{2} + 3 \\ln{\\left(3 \\right)}",
      "-3 + \\frac{\\log{\\left(2 \\pi \\right)}}{2} + 3 \\log{\\left(3 \\right)}"
    ]
  },
