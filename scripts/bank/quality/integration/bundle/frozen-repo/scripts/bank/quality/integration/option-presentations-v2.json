{
  "cn_021e4a9a6081202b1990": {
    "auditId": "io3-v1",
    "familyId": "io3-principal-value",
    "revision": 1,
    "sourceContentHash": "f2f33b7feec56893f3591687ba0b0067ac87f658203b93b867f7c7baf6198115",
    "steps": [
      "\\text{Write }I\\text{ for the displayed improper-integral expression.}",
      "\\lim_{x\\to1}(x-1)\\frac{x^{4}}{1-x^{11}}=-\\frac1{11}\\ne0",
      "\\text{The ordinary integral diverges because each one-sided integral at the pole diverges.}",
      "r=\\frac{5}{11}\\in(0,1),\\quad t=x^{11}",
      "\\text{For symmetric cutoffs at the original pole, the transformed cutoff ratio tends to one.}",
      "\\lim_{\\delta\\downarrow0}\\frac{(1+\\delta)^{11}-1}{1-(1-\\delta)^{11}}=1",
      "\\text{In the upper piece use }u=1/t\\text{; combine both pieces on }(0,1).",
      "\\operatorname{PV}I=\\frac1{11}\\int_0^1\\frac{u^{r-1}-u^{-r}}{1-u}\\,du",
      "\\int_0^1\\frac{u^{r-1}-u^{-r}}{1-u}\\,du=\\pi\\cot(\\pi r)",
      "\\text{This is the digamma reflection identity, equivalently its convergent difference series.}",
      "\\operatorname{PV}I=\\frac\\pi{11}\\cot\\left(\\frac{5}{11}\\pi\\right)",
      "\\text{Therefore (ordinary integral, principal value) is }\\left(\\textnormal{divergent},\\ \\frac{\\pi \\cot{\\left(\\frac{5 \\pi}{11} \\right)}}{11}\\right)",
      "\\left(\\textnormal{divergent},\\ \\frac{\\pi \\cot{\\left(\\frac{5 \\pi}{11} \\right)}}{11}\\right)"
    ],
    "statement": "\\textnormal{For }I=\\int_0^\\infty\\frac{x^{4}}{1-x^{11}}\\,\\mathrm{d}x\\textnormal{, choose the pair (ordinary integral, Cauchy principal value at }x=1\\textnormal{).}"
  },
