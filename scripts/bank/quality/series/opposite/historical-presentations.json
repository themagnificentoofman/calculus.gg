    "sourceContentHash": "50cae312f1d88e4a02d58010d76953703b6180fcdc42ae0ee102afccdd924b0d",
    "steps": [
      "\\frac1{k+4}=\\int_0^1t^{k+3}\\,\\mathrm dt",
      "\\sum_{k=0}^{4}\\frac{(-1)^k\\binom{4}k}{k+4}=\\int_0^1t^{3}\\sum_{k=0}^{4}\\binom{4}k(-t)^k\\,\\mathrm dt=\\int_0^1t^{3}(1-t)^{4}\\,\\mathrm dt",
      "\\textnormal{The sum is finite, so the interchange needs no convergence theorem. The beta integral for positive integer exponents evaluates the last polynomial integral.}",
      "\\int_0^1t^{a-1}(1-t)^{b-1}\\,\\mathrm dt=\\frac{(a-1)!(b-1)!}{(a+b-1)!}\\quad(a,b\\in\\mathbb Z_{>0})",
      "a=4,\\quad b=5\\quad\\Longrightarrow\\quad\\frac{3!\\,4!}{8!}=\\frac{1}{280}",
      "\\frac{1}{280}"
    ]
  },
