    "sourceContentHash": "b7b54beba99356311507250e362631b8771d572240d1fb75add3b02e23498beb",
    "steps": [
      "g(u)=\\sqrt{12+u},\\qquad0\\le u\\le4\\ \\Longrightarrow\\ 0\\le g(u)\\le4",
      "g(u)^2-u^2=12+u-u^2=(4-u)(u+3)\\ge0",
      "\\textnormal{The nonnegative iterates therefore increase and stay bounded. Let their limit be denoted by the following symbol.}",
      "\\ell=\\lim_{n\\to\\infty}a_n\\in[0,4],\\qquad\\ell^2-\\ell-12=0",
      "(\\ell-4)(\\ell+3)=0\\quad\\Longrightarrow\\quad\\ell=4",
      "4"
    ]
  },
