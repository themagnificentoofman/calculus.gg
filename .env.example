# Server-only runtime secrets. Set through the hosting service's secret settings.
# Never use NEXT_PUBLIC_ for the OpenAI API key.
OPENAI_API_KEY=
# Optional override. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Dedicated Firestore service account JSON, restricted to the existing named database.
FIREBASE_SERVICE_ACCOUNT_JSON=

# For local Cloudflare preview copy these names into untracked .dev.vars.
# Firebase browser configuration is retained in firebase-applet-config.json.
