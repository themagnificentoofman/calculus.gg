rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model / trust boundary:
    // users/{uid}: private account (email/settings/friends) + earned statistics.
    // users_public/{uid}: explicit public name/avatar/handle/presence/statistics projection.
    // games/{id}: server-written mode/status/players/scores/deadline, redacted questions,
    //             result receipts and chat. No selected choices or answer keys.
    // games/{id}/reviews/{uid}: only this player's accepted answers and explanations.
    // questionSets/{id}, gameSecrets/{id}: server-only generated keys and full game state.
    // friendRequests/{id}, gameInvites/{id}: immutable participant IDs and server-checked
    //             pending -> accepted/rejected transitions.
    // ALL client writes are denied. Domain validation, identity checks and transactions
    // run in authenticated server endpoints using a dedicated database-scoped IAM identity.
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isMember(gameId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.players;
    }
    match /users/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /users_public/{uid} { allow read: if isAuthenticated(); allow write: if false; }
    match /games/{gameId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.players ||
        (resource.data.progressionVersion == 3 && resource.data.status == 'waiting' && resource.data.mode in ['pvp', 'multiplayer']));
      allow write: if false;
      match /reviews/{uid} { allow read: if isOwner(uid) && isMember(gameId); allow write: if false; }
    }
    match /friendRequests/{id} {
      allow read: if isAuthenticated() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }
    match /gameInvites/{id} {
      allow read: if isAuthenticated() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
